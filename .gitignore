.cache/
huggingface/
models/
checkpoints/

# Built archives are reproducible from tracked inputs.
artifacts/*.tar.gz
artifacts/*.zip

# Credentials and local deployment material
.env
*.token
*.pem
*.key
*.secret

# Local JSS compilation output is reproducible and not needed in source control
submission/*/build/
