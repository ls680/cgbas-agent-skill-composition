__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# LaTeX intermediates; keep manuscript PDFs.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
